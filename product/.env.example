# Copy to .env (gitignored) and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env
# run.py and tools/live_checks.py read it themselves (apex/envfile.py); no need to source it.
# Variables already exported in your shell win over this file.

# Meta API key, read by apex/llm_service.py (sent only in the Authorization header; never logged).
MODEL_API_KEY=
